; Re-expose the vendored OCaml emulator's core (upstream's `oberon-risc` library) as a
; library in OUR project. The submodule is data here (see ../dune), so we compile its
; lib/ sources instead. This is reproducible (lives in this repo) and keeps the
; submodule pristine.
;
; Warnings are silenced (-w -a): this is third-party code we don't lint.
; Only dependency is unix (matching the emulator's own lib/dune).

(copy_files ../oberon-risc-emu-ocaml/lib/*.ml)

(copy_files ../oberon-risc-emu-ocaml/lib/*.mli)

(library
 (name emu)
 (libraries unix)
 (flags
  (:standard -w -a)))
