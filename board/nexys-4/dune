; The Nexys 4 board layer: library nexys4_board. It depends on risc5 one way, so lib/
; stays board-independent. cellram_model, a behavioural double of the external PSRAM chip,
; is instantiated only by tests and never reaches synthesis. Inline tests are co-located as
; in lib/, so their tooling (hardcaml_waveterm, qcheck-core) sits in (libraries).

(library
 (name nexys4_board)
 (modules
  (:standard \ emit_verilog))
 (libraries risc5 hardcaml hardcaml_waveterm qcheck-core)
 ; -source-tree-root override: same ppx_expect >= 130.100 path skew as lib/dune.
 ; build_config.ml's test reads the two hand-written files that restate its clock.
 (inline_tests
  (flags -source-tree-root .)
  (deps nexys4_top.v nexys4.xdc))
 (preprocess
  (pps ppx_hardcaml ppx_expect)))

; Emit the board SoC as Verilog with the boot ROM baked in — the design's own ROM
; (Risc5.Rom), so no oracle. gen_verilog.sh runs it → board/_generated/nexys-4/soc_board.v,
; which nexys4_top.v wraps with the vendor primitives. Built by @check so it can't rot.

(executable
 (name emit_verilog)
 (modules emit_verilog)
 (libraries hardcaml nexys4_board risc5))
