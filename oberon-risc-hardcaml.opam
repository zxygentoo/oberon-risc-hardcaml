# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cycle-accurate Hardcaml port of Wirth's Oberon RISC5 CPU/SoC"
description: """
A synthesizable Hardcaml port of the Project Oberon RISC5 machine, built one
module at a time from the original Verilog and verified in lockstep against the
OCaml Oberon RISC emulator (oberon-risc-emu-ocaml). Targets the Digilent
Nexys 4 (Xilinx Artix-7)."""
maintainer: ["zxy <zxygentoo@gmail.com>"]
authors: ["zxy <zxygentoo@gmail.com>"]
license: "MIT"
homepage: "https://github.com/zxygentoo/oberon-risc-hardcaml"
bug-reports: "https://github.com/zxygentoo/oberon-risc-hardcaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.2.0"}
  "hardcaml" {>= "v0.18~preview"}
  "hardcaml_waveterm" {>= "v0.18~preview"}
  "ppx_hardcaml" {>= "v0.18~preview"}
  "hardcaml_verify" {>= "v0.18~preview"}
  "hardcaml_of_verilog" {>= "v0.18~preview"}
  "ppx_expect"
  "qcheck-core"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zxygentoo/oberon-risc-hardcaml.git"
