; The measurement gauges — reports, not pass/fail tests, so kept out of `dune runtest` and
; driven by alias:
;   dune build @bench           cycles per operation under each choice of multipliers
;   dune build @profile_boot    dynamic MUL/DIV count over a boot (Amdahl context)
; Only the TARGET-INDEPENDENT gauges live here (the lib core / the oracle). The third,
; @bench_boot (the board machine's stall profile, memory-stack ladder and miss autopsy),
; is board-specific and lives in the board-test mirror, test/board/nexys-4/ — README.md
; here is the index for all three.

(executable
 (name bench_core)
 (modules bench_core)
 (libraries risc5 hardcaml))

(rule
 (alias bench)
 (action
  (run ./bench_core.exe)))

(executable
 (name profile_boot)
 (modules profile_boot)
 (libraries emu boot_checkpoint_common))

(rule
 (alias profile_boot)
 (deps
  ../../vendor/oberon-risc-emu-ocaml/DiskImage/Oberon-2020-08-18.dsk
  (env_var DISK_IMG))
 (action
  (run ./profile_boot.exe)))
