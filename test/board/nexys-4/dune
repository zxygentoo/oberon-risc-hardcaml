; Board (Nexys 4) SoC integration tests + the board bench — mirror board/nexys-4/ under
; test/. All close the PSRAM board SoC with cellram_model through the shared board_tb
; harness (this dir). Built by @check so they can't rot; opt-in to run, like the other
; heavyweight checks (§6):
;   dune build @boot_checkpoint_board   dune build @visual_golden_board
;   dune build @bench_boot              (the board gauge; index in test/bench/README.md)

(library
 (name board_tb)
 (modules board_tb)
 (libraries risc5 nexys4_board hardcaml)
 (preprocess
  (pps ppx_hardcaml)))

; Phase 7: board boot-handoff checkpoint — the same boot proven through the PSRAM board SoC
; (the board Soc + cellram_model), the SoC-independent half shared with the BRAM checkpoint via
; boot_checkpoint_common. Run: dune build @boot_checkpoint_board

(executable
 (name test_boot_checkpoint_board)
 (modules test_boot_checkpoint_board)
 (libraries
  risc5
  nexys4_board
  emu
  hardcaml
  sd_bridge
  boot_checkpoint_common
  boot_tb
  board_tb))

(rule
 (alias boot_checkpoint_board)
 (deps
  ../../../vendor/oberon-risc-emu-ocaml/DiskImage/Oberon-2020-08-18.dsk
  (env_var ICACHE)
  (env_var LINES_LOG2)
  (env_var WRITE_UPDATE)
  (env_var FB_BRAM)
  (env_var HALFTONE)
  (env_var WBUF)
  (env_var FAST_MUL)
  (env_var MUL_STAGES)
  (env_var READ_CYCLES)
  (env_var WRITE_CYCLES)
  (env_var SPI_DIV_LOG2)
  (env_var DISK_IMG))
 (action
  (run ./test_boot_checkpoint_board.exe)))

; Phase-10a: board visual golden WITH the I-cache — the coherence proof. Boots the PSRAM board
; SoC with the cache ON past the handoff and asserts the desktop framebuffer is byte-identical
; to the oracle. Run: dune build @visual_golden_board

(executable
 (name test_visual_golden_board)
 (modules test_visual_golden_board)
 (libraries
  risc5
  nexys4_board
  emu
  hardcaml
  sd_bridge
  boot_checkpoint_common
  boot_tb
  board_tb))

(rule
 (alias visual_golden_board)
 (deps
  ../../../vendor/oberon-risc-emu-ocaml/DiskImage/Oberon-2020-08-18.dsk
  (env_var ICACHE)
  (env_var LINES_LOG2)
  (env_var WRITE_UPDATE)
  (env_var FB_BRAM)
  (env_var HALFTONE)
  (env_var WBUF)
  (env_var FAST_MUL)
  (env_var MUL_STAGES)
  (env_var READ_CYCLES)
  (env_var WRITE_CYCLES)
  (env_var SPI_DIV_LOG2)
  (env_var DISK_IMG)
  (env_var SOC_CAP))
 (action
  (run ./test_visual_golden_board.exe)))

; The board gauge (a report, not a pass/fail test): the running-OS stall profile of the
; configured machine, the memory stack added one layer at a time, and the cache-miss
; autopsy. It lives here (not test/bench/) because it is board-specific through and through
; — it builds the board Soc via board_tb and probes board signal names — while test/bench/
; keeps the target-independent gauges. The gauge index is test/bench/README.md.

(executable
 (name bench_boot)
 (modules bench_boot)
 ; board_tb brings the board Soc + Cellram_model wiring — and risc5 / nexys4_board
 ; transitively; the bench itself derives no interfaces, so no ppx.
 (libraries
  board_tb
  emu
  hardcaml
  sd_bridge
  boot_checkpoint_common
  boot_tb
  fork_pool))

(rule
 (alias bench_boot)
 (deps
  ../../../vendor/oberon-risc-emu-ocaml/DiskImage/Oberon-2020-08-18.dsk
  (env_var ICACHE)
  (env_var LINES_LOG2)
  (env_var WRITE_UPDATE)
  (env_var FB_BRAM)
  (env_var HALFTONE)
  (env_var WBUF)
  (env_var FAST_MUL)
  (env_var MUL_STAGES)
  (env_var READ_CYCLES)
  (env_var WRITE_CYCLES)
  (env_var SPI_DIV_LOG2)
  (env_var DISK_IMG))
 (action
  (run ./bench_boot.exe)))
